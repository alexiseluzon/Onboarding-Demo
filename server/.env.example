PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require"

# Firebase service account JSON, stringified (from Firebase Console > Project Settings > Service Accounts)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"..."}'

# Stripe secret key (server-side only, never expose client-side)
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe webhook signing secret (from `stripe listen` locally, or the Dashboard in production)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# HubSpot private app token (for the nice-to-have HubSpot push endpoint)
HUBSPOT_ACCESS_TOKEN=